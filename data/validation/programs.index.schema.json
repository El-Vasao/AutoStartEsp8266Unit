{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autostart.local/schemas/programs.index.schema.json",
  "title": "AutoStart programs index (frontend validation)",
  "type": "array",
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "integer", "minimum": 1, "maximum": 255 },
      "name": { "type": "string", "minLength": 1, "maxLength": 31 }
    }
  }
}

